# Copy to .env (never commit .env). Every setting can be overridden as RAG__<SECTION>__<KEY>.

# Configuration layering (comma-separated, merged left → right)
RAG_CONFIG_FILE=config/rag.yaml
# RAG_CONFIG_FILE=config/rag.yaml,config/profiles/qdrant-hybrid.yaml
# RAG_CONFIG_FILE=config/rag.yaml,config/profiles/qdrant-hybrid.yaml,config/profiles/production.yaml

RAG_ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console
PORT=8080

# Vector stores
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
PG_DSN=postgresql://rag:rag@localhost:5432/rag

# Source registry (SQLite for dev; PostgreSQL in production)
REGISTRY_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# Model cache for FastEmbed
FASTEMBED_CACHE=./data/models

# LLM providers (only the one you configure is used)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# provider: claude_lite_llm (personal use, no API key): run `claude login`, or use a token from `claude setup-token`.
# The adapter removes ANTHROPIC_API_KEY from the CLI's environment so calls stay on the subscription.
# CLAUDE_CODE_OAUTH_TOKEN=

# Production API keys — store SHA-256 digests, not keys:  echo -n "$KEY" | shasum -a 256
RAG_ADMIN_KEY_SHA256=
RAG_INGEST_KEY_SHA256=
RAG_QUERY_KEY_SHA256=

# Examples of direct overrides
# RAG__DEFAULTS__RETRIEVAL__TOP_K=8
# RAG__SECURITY__AUTH_ENABLED=true
